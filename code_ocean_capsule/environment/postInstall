#!/usr/bin/env bash
set -e
apt-get update
apt-get install -y swig

# Gym 0.24.0 has legacy metadata rejected by pip 24.1 and newer.
python3 -m pip install pip==22.1.2

# Keep these pins in sync with code/requirements.txt.
python3 -m pip install \
    toml==0.10.2 \
    torch==2.2.2 \
    torchvision==0.17.2 \
    torchaudio==2.2.2 \
    'gym[box2d]==0.24.0' \
    gym-notices==0.0.7 \
    tqdm==4.70.0 \
    scikit-learn==1.6.1 \
    numpy==1.26.4 \
    matplotlib==3.9.4 \
    Pillow==11.3.0
