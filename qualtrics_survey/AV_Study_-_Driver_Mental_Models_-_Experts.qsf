ibute":"In your own words, and in as much detail as possible, please explain your reasoning for this pred...","TertiaryAttribute":null,"Payload":{"QuestionText":"In your own words, and in as much detail as possible, please explain your reasoning for this prediction.<i><\/i><br>","DefaultChoices":false,"QuestionType":"TE","Selector":"ESTB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"In your own words, and in as much detail as possible, please explain your reasoning for this pred...","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionText_Unsafe":"<b><i>Step 2:<\/i><\/b><br>In your own words, please explain your understanding of why the AV stopped.","DataExportTag":"Q38","QuestionID":"QID38"}},{"SurveyID":"SV_byBblheEaWmuniu","Element":"SQ","PrimaryAttribute":"QID39","SecondaryAttribute":"Step 4: (video with explanation) Please watch this video which shows the driver's point of view i...","TertiaryAttribute":null,"Payload":{"QuestionText":"<em><strong>Step 4: (video with explanation) <\/strong><\/em><br \/>\nPlease watch this video which shows the driver&#39;s point of view in a self-driving car, <b>now with the concepts it currently detects<\/b>.<br \/>\n<br \/>\n<iframe allowfullscreen=\"true\" frameborder=\"0\" height=\"600\" src=\"https:\/\/www.youtube.com\/embed\/cNsxElZbZeQ\" width=\"750\"><\/iframe><br \/>\n.","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline"},"QuestionDescription":"Step 4: (video with explanation) Please watch this video which shows the driver's point of view i...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":3,"