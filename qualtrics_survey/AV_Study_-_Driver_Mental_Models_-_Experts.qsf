"QuestionID":"QID131"}},{"SurveyID":"SV_byBblheEaWmuniu","Element":"SQ","PrimaryAttribute":"QID132","SecondaryAttribute":"Step 2: Do you think the AV slowed down mainly because of the stop sign and road bump?","TertiaryAttribute":null,"Payload":{"QuestionText":"<b><i>Step 2:<\/i><\/b><br>\nDo you think the AV slowed down mainly because of the stop sign and road bump?","DefaultChoices":false,"QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Step 2: Do you think the AV slowed down mainly because of the stop sign and road bump?","Choices":{"1":{"Display":"Yes"},"2":{"Display":"No"}},"ChoiceOrder":[1,2],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":3,"NextAnswerId":1,"QuestionText_Unsafe":"<b><i>Step 2:<\/i><\/b><br \/>\nDo you think the AV stopped because of the PUDO (i.e., pedestrian pickup and drop-off) region ahead?","DataExportTag":"Q132","QuestionID":"QID132"}},{"SurveyID":"SV_byBblheEaWmuniu","Element":"SQ","PrimaryAttribute":"QID133","SecondaryAttribute":"Now provide a confidence rating for this prediction.","TertiaryAttribute":null,"Payload":{"QuestionText":"Now provide a confidence rating for this prediction.","DefaultChoices":false,"QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","ChoiceColumnWidth":25,"RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true},"QuestionDescription":"Now provide a confidence rating for this prediction.","Choices":{"1":{"Display":"How confident are you in this prediction?"}},"ChoiceOrder":[1],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":2,"NextAnswerId":8,"Answers":{"